#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent passwd vsdm2-client >/dev/null; then
      adduser --system --group --quiet --no-create-home \
              --home /var/lib/vsdm2-client \
              --gecos "VSDM 2.0 client" vsdm2-client
    fi
    # Keystores here are opened by the JVM as user vsdm2-client. Group-own the
    # directory to the service and drop world access, so keys stay unreadable
    # to everyone else. The unit re-applies this to *.p12 on every start.
    chown root:vsdm2-client /etc/vsdm2-client
    chmod 750 /etc/vsdm2-client
    ;;
esac

if [ -x /usr/bin/deb-systemd-helper ]; then
  deb-systemd-helper unmask vsdm2-client.service >/dev/null || true
  if deb-systemd-helper --quiet was-enabled vsdm2-client.service; then
    deb-systemd-helper enable vsdm2-client.service >/dev/null || true
  else
    deb-systemd-helper update-state vsdm2-client.service >/dev/null || true
  fi
fi

if [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload >/dev/null || true
  # Restart on upgrade only. A fresh install has no Konnektor endpoint or
  # keystore configured yet, so starting it would just crash-loop.
  if [ -n "$2" ]; then
    deb-systemd-invoke try-restart vsdm2-client.service >/dev/null || true
  else
    echo "vsdm2-client: edit /etc/default/vsdm2-client, then run:"
    echo "  systemctl start vsdm2-client"
  fi
fi

exit 0
